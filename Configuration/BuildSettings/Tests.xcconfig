// Torravia Tests build settings.

BUNDLE_LOADER = $(TEST_HOST)
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 16
DEAD_CODE_STRIPPING = YES
DEPLOYMENT_LOCATION = YES
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -
CODE_SIGNING_REQUIRED = NO
DSTROOT = /Applications
ENABLE_USER_SCRIPT_SANDBOXING = YES
GENERATE_INFOPLIST_FILE = YES
INSTALL_PATH = /Torravia.app/Contents/PlugIns
MACOSX_DEPLOYMENT_TARGET = 14.0
MARKETING_VERSION = 1.0.15
PRODUCT_BUNDLE_IDENTIFIER = org.torravia.TorraviaTests
PRODUCT_NAME = TorraviaTests
SDKROOT = macosx
SKIP_INSTALL = NO
STRING_CATALOG_GENERATE_SYMBOLS = NO
SUPPORTED_DESTINATIONS = macOS
SUPPORTED_PLATFORMS = macosx
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_EMIT_LOC_STRINGS = NO
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_VERSION = 5.0
TEST_HOST = /Applications/Torravia.app/Contents/MacOS/Torravia
