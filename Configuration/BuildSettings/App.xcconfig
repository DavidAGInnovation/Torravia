// Torravia App build settings.

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
CODE_SIGN_STYLE = Automatic
COMBINE_HIDPI_IMAGES = YES
CURRENT_PROJECT_VERSION = 16
DEAD_CODE_STRIPPING = YES
DEPLOYMENT_LOCATION = YES
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -
CODE_SIGNING_REQUIRED = NO
DSTROOT = /Applications
ENABLE_APP_SANDBOX = YES
ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
ENABLE_USER_SELECTED_FILES = readonly
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Configuration/Torravia-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Torravia
INFOPLIST_KEY_CFBundleName = Torravia
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities
INFOPLIST_KEY_NSHumanReadableCopyright = ""
INFOPLIST_KEY_NSUserNotificationUsageDescription = We send notifications when downloads complete.
INSTALL_PATH = /
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
MARKETING_VERSION = 1.0.15
// Public builds use a separate identity from existing private installations.
PRODUCT_BUNDLE_IDENTIFIER = org.torravia.Torravia
PRODUCT_NAME = Torravia
REGISTER_APP_GROUPS = YES
SDKROOT = macosx
STRING_CATALOG_GENERATE_SYMBOLS = YES
SUPPORTED_DESTINATIONS = macOS
SUPPORTED_PLATFORMS = macosx
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_VERSION = 5.0
